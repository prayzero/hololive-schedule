{
  "name": "hololive-schedule",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "update:schedule": "node scripts/update-hololive-schedule.mjs",
    "collect:youtube-archive": "node scripts/collect-youtube-live-archive.mjs",
    "enrich:youtube-archive": "node scripts/enrich-youtube-live-metadata.mjs",
    "update:youtube-archive": "node scripts/compile-youtube-live-archive.mjs",
    "update:hololive-dreams": "node scripts/update-hololive-dreams.mjs",
    "update:card-game": "node scripts/update-hololive-card-game.mjs",
    "update:wafers": "node scripts/update-hololive-wafers.mjs",
    "update:music": "node scripts/update-hololive-music.mjs",
    "test:security": "node --test scripts/security-policies.test.mjs",
    "validate:data": "node scripts/validate-public-data.mjs",
    "build": "npm run test:security && node scripts/validate-public-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run build"
  },
  "dependencies": {
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "cheerio": "1.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
